[Unit]
Description=nyx-keyd persistent libei key injector (Wayland)
Documentation=file:/usr/local/lib/nyx-gestures/VERSION
After=graphical-session.target

[Service]
Type=simple
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/local/bin/nyx-keyd
Restart=always
RestartSec=3

[Install]
WantedBy=graphical-session.target